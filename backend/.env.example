PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/fleet_management

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_value
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173

# Separate from JWT_SECRET so token signing and owner bootstrap do not share one secret.
SEED_SECRET=replace_me_with_a_different_long_random_value

# Document storage: omit OBJECT_STORAGE_PROVIDER to use local disk
# OBJECT_STORAGE_PROVIDER=s3
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=false

